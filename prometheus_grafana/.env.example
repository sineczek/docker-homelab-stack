# ===== Grafana admin =====
GF_SECURITY_ADMIN_USER=
GF_SECURITY_ADMIN_PASSWORD=

# ===== Pi-hole exporter =====
# Adres do pihole (URL z http/https i ewentualnym portem), np. http://pihole:80 lub https://pihole.sinq.cc
PIHOLE1_URL=
PIHOLE2_URL=
PIHOLE3_URL=

# Jeśli używasz hasła admina (classic) lub tokenu API – wstaw tutaj:
PIHOLE_PASSWORD=

# ===== NGINX exporter =====
# URL do stub_status w Twoim Nginx (wewnątrz tej samej sieci 'proxy'):
# Jeśli masz stub_status na 127.0.0.1:8080/stub_status to z innego kontenera użyj nazwy serwisu/nginx i portu:
NGINX_STATUS_URL=

# ===== Home Assistant =====
# Umieść Long-Lived Access Token do HA w pliku: prometheus/secrets/homeassistant_token.txt
# oraz ustaw bazowy URL HA (wewnątrz sieci wspólnej – najczęściej nazwa serwisu z compose HA):
HOMEASSISTANT_BASE_URL=

# ===== Immich Postgres =====
# W pliku prometheus/secrets/postgres_dsn.txt umieść DSN, np.:
# postgresql://immich:IMMICH_PASSWORD@immich-postgres:5432/immich?sslmode=disable

# ===== Rclone (opcjonalnie) =====
# Jeżeli w rclone włączysz --rc --rc-addr=:5572 i --metrics – ustaw URL tutaj (wewnętrznie)
RCLONE_METRICS_URL=


# ===== Alertmanager odbiorcy (uzupełnij wg potrzeb) =====
# Telegram
AM_TG_BOT_TOKEN=
AM_TG_CHAT_ID=
# Discord (webhook)
AM_DISCORD_WEBHOOK=
# Email (SMTP)

AM_SMTP_FROM=
AM_SMTP_HOST=
AM_SMTP_USER=
AM_SMTP_PASS=
AM_SMTP_TO=
